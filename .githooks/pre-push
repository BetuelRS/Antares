#!/bin/sh
#
# Regra F1 · docs/referencia/regras.md
#
# Um segredo publicado não se despublica: fica no histórico do git, nos clones que já
# foram feitos e nos espelhos que o GitHub guarda. É por isso que esta verificação está
# no `pre-push` e não no `pre-commit` — um commit local ainda se refaz.
#
# Instalar: git config core.hooksPath .githooks

set -u

procura() {
    git ls-files -z | xargs -0 grep -lIE "$1" 2>/dev/null
}

# `sk-ant-` cobre as chaves de API e de administração da Anthropic; `eyJ` é o início de
# qualquer token JWT em base64, e apanha as chaves service_role do Supabase.
chaves=$(procura 'sk-ant-(api|admin)[A-Za-z0-9_-]{10,}')
tokens=$(procura 'eyJ[A-Za-z0-9_-]{40,}')

if [ -n "$chaves" ] || [ -n "$tokens" ]; then
    echo ""
    echo "PUSH TRAVADO — há segredos em ficheiros seguidos pelo git:"
    [ -n "$chaves" ] && echo "" && echo "  chaves da Anthropic:" && echo "$chaves" | sed 's/^/    /'
    [ -n "$tokens" ] && echo "" && echo "  tokens JWT:" && echo "$tokens" | sed 's/^/    /'
    echo ""
    echo "  Tira o segredo, refaz o commit, e só depois publica."
    echo "  Valores públicos vão em local.properties, que já está ignorado."
    echo ""
    exit 1
fi

exit 0
